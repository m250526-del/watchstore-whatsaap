# Your PRIMARY WhatsApp number (the one Baileys connects to, no + or spaces, country code first)
PRIMARY_NUMBER=923XXXXXXXXX

# SECONDARY / fallback number shown in the manual wa.me button if Baileys is down or the customer's number isn't on WhatsApp
SECONDARY_NUMBER=923XXXXXXXXX

# Shared secret — WordPress must send this in the X-API-Key header on every request.
# Generate any long random string, put the SAME value in your WordPress plugin settings.
API_KEY=change-this-to-a-long-random-string

# Port the server listens on
PORT=3000
# neon
DATABASE_URL=your-real-neon-connection-string-here